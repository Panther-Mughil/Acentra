@inject ToastService ToastService
@implements IDisposable

<div class="toast-container-org">
    @foreach (var toast in ToastService.Messages)
    {
        <div class="toast-card-org @toast.Level.ToString().ToLowerInvariant()" role="alert">
            <div style="margin-top: 2px;">
                @switch (toast.Level)
                {
                    case ToastLevel.Success:
                        <span style="color: var(--green-600);"><IconSvg Name="check" Size="18" /></span>
                        break;
                    case ToastLevel.Warning:
                        <span style="color: var(--amber-500);"><IconSvg Name="warning" Size="18" /></span>
                        break;
                    case ToastLevel.Error:
                        <span style="color: var(--red-600);"><IconSvg Name="alert-triangle" Size="18" /></span>
                        break;
                    default:
                        <span style="color: var(--blue-600);"><IconSvg Name="shield-check" Size="18" /></span>
                        break;
                }
            </div>
            <div style="flex: 1;">
                <div style="font-weight: 700; font-size: 13.5px; color: var(--navy-900);">@toast.Title</div>
                <div style="font-size: 12.5px; color: var(--text-muted); margin-top: 2px;">@toast.Message</div>
            </div>
            <button class="btn" style="padding: 0; background: none; border: none; color: var(--text-light); cursor: pointer;"
                    @onclick="() => ToastService.RemoveToast(toast.Id)">
                <IconSvg Name="close" Size="14" />
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnToastAdded += HandleToastAdded;
        ToastService.OnToastRemoved += HandleToastRemoved;
    }

    private void HandleToastAdded(ToastMessage message)
    {
        InvokeAsync(StateHasChanged);
        Task.Delay(message.DurationMs).ContinueWith(_ =>
        {
            ToastService.RemoveToast(message.Id);
        });
    }

    private void HandleToastRemoved(string id)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ToastService.OnToastAdded -= HandleToastAdded;
        ToastService.OnToastRemoved -= HandleToastRemoved;
    }
}
