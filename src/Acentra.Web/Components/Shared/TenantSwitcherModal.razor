@inject TenantStateService TenantService
@inject NavigationManager Nav
@implements IDisposable

@if (IsOpen)
{
    <div class="modal-backdrop-org" @onclick="Close">
        <div class="modal-content-org" @onclick:stopPropagation style="max-width: 540px;">
            <div class="modal-header-org">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--navy-900); color: #FFF; display: flex; align-items: center; justify-content: center;">
                        <IconSvg Name="tenant" Size="18" />
                    </div>
                    <div>
                        <h3 style="font-size: 16px; margin: 0; font-weight: 700; color: var(--navy-900);">SELECT ORGANIZATION</h3>
                        <p style="font-size: 12px; color: var(--text-muted); margin: 0;">Isolated multi-tenant cryptographic workspace context</p>
                    </div>
                </div>
                <button class="header-icon-btn" @onclick="Close" style="width: 32px; height: 32px;">
                    <IconSvg Name="close" Size="14" />
                </button>
            </div>

            <div class="modal-body-org" style="padding: 18px 24px;">
                @if (!isAddingOrg)
                {
                    <div style="margin-bottom: 16px; position: relative;">
                        <input type="text" class="form-control-org" placeholder="Search organizations or regions..."
                               @bind="searchTerm" @bind:event="oninput" style="padding-left: 36px;" />
                        <div style="position: absolute; left: 12px; top: 11px; color: var(--text-light);">
                            <IconSvg Name="search" Size="16" />
                        </div>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 8px; max-height: 320px; overflow-y: auto;">
                        @foreach (var tenant in FilteredTenants)
                        {
                            var isCurrent = tenant.Id == TenantService.CurrentTenant.Id;
                            <div style="border: 1.5px solid @(isCurrent ? "var(--blue-600)" : "var(--border-subtle)"); background-color: @(isCurrent ? "var(--blue-50)" : "#FFFFFF"); border-radius: var(--border-radius-md); padding: 14px; cursor: pointer; transition: all var(--transition-fast);"
                                 @onclick="() => SelectTenant(tenant.Id)">
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <div style="display: flex; align-items: center; gap: 12px;">
                                        <div style="width: 10px; height: 10px; border-radius: 50%; background-color: @(isCurrent ? "var(--blue-600)" : "var(--green-600)");"></div>
                                        <div>
                                            <div style="font-size: 14px; font-weight: 700; color: var(--navy-900);">@tenant.Name</div>
                                            <div style="font-size: 12px; color: var(--text-muted);">@tenant.Region • @tenant.Branches.Count branches</div>
                                        </div>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span class="sku-badge" style="font-size: 10.5px;">@tenant.Id</span>
                                        @if (isCurrent)
                                        {
                                            <span style="color: var(--blue-600);"><IconSvg Name="check" Size="16" /></span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div style="border-top: 1px solid var(--border-subtle); margin-top: 16px; padding-top: 14px; display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 12px; color: var(--text-muted);">Showing @FilteredTenants.Count registered healthcare tenants</span>
                        <button class="btn-org btn-org-secondary btn-org-sm" @onclick="() => isAddingOrg = true">
                            <IconSvg Name="plus" Size="14" /> + Add organization
                        </button>
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; gap: 14px;">
                        <div style="font-weight: 700; font-size: 14px; color: var(--navy-900); display: flex; align-items: center; justify-content: space-between;">
                            <span>Register New Healthcare Tenant</span>
                            <button class="btn btn-link btn-sm" style="color: var(--text-muted); text-decoration: none;" @onclick="() => isAddingOrg = false">Back to List</button>
                        </div>
                        <div>
                            <label style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; display: block;">Organization Name</label>
                            <input type="text" class="form-control-org" placeholder="e.g. Fortis Health Alliance" @bind="newOrgName" />
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; display: block;">Tenant Code</label>
                                <input type="text" class="form-control-org" placeholder="e.g. FORTIS-HA" @bind="newOrgCode" />
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; display: block;">Region / State</label>
                                <input type="text" class="form-control-org" placeholder="e.g. Karnataka" @bind="newOrgRegion" />
                            </div>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; display: block;">Primary Branch Name</label>
                                <input type="text" class="form-control-org" placeholder="e.g. Bangalore Main Hospital" @bind="newBranchName" />
                            </div>
                            <div>
                                <label style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px; display: block;">City</label>
                                <input type="text" class="form-control-org" placeholder="e.g. Bangalore" @bind="newCity" />
                            </div>
                        </div>

                        <div style="background-color: var(--teal-50); border: 1px solid rgba(0, 166, 166, 0.25); border-radius: var(--border-radius-md); padding: 10px 14px; font-size: 12px; color: var(--teal-700); display: flex; align-items: center; gap: 8px;">
                            <IconSvg Name="shield-check" Size="16" />
                            <span>A dedicated KMS AES-256 master key and isolated storage partition will be provisioned.</span>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer-org">
                @if (isAddingOrg)
                {
                    <button class="btn-org btn-org-secondary" @onclick="() => isAddingOrg = false">Cancel</button>
                    <button class="btn-org btn-org-primary" @onclick="HandleAddOrganization" disabled="@(string.IsNullOrWhiteSpace(newOrgName))">
                        <IconSvg Name="plus" Size="14" /> Provision Tenant
                    </button>
                }
                else
                {
                    <button class="btn-org btn-org-secondary" @onclick="Close">Close</button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private string searchTerm = "";
    private bool isAddingOrg = false;
    private string newOrgName = "";
    private string newOrgCode = "";
    private string newOrgRegion = "";
    private string newBranchName = "";
    private string newCity = "";

    private List<Tenant> FilteredTenants => string.IsNullOrWhiteSpace(searchTerm)
        ? TenantService.AvailableTenants
        : TenantService.AvailableTenants.Where(t =>
            t.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            t.Region.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            t.Id.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
        ).ToList();

    protected override void OnInitialized()
    {
        TenantService.OnTenantChanged += StateHasChanged;
    }

    private void SelectTenant(string tenantId)
    {
        TenantService.SwitchTenant(tenantId);
        Close();
    }

    private void HandleAddOrganization()
    {
        if (string.IsNullOrWhiteSpace(newOrgName)) return;

        var code = string.IsNullOrWhiteSpace(newOrgCode) ? newOrgName.Substring(0, Math.Min(4, newOrgName.Length)).ToUpper() : newOrgCode;
        var region = string.IsNullOrWhiteSpace(newOrgRegion) ? "India" : newOrgRegion;
        var branch = string.IsNullOrWhiteSpace(newBranchName) ? $"{newOrgName} Central Hospital" : newBranchName;
        var city = string.IsNullOrWhiteSpace(newCity) ? "Central Metro" : newCity;

        TenantService.AddOrganization(newOrgName, code, region, branch, city);
        isAddingOrg = false;
        newOrgName = "";
        newOrgCode = "";
        newOrgRegion = "";
        newBranchName = "";
        newCity = "";
        Close();
    }

    private void Close()
    {
        IsOpen = false;
        IsOpenChanged.InvokeAsync(false);
    }

    public void Dispose()
    {
        TenantService.OnTenantChanged -= StateHasChanged;
    }
}
