@*
    Merged shell: the `ajes` enterprise chrome (sidebar + TopHeader + global modals) with our
    own tenant switcher kept in the content area.

    The tenant switcher is the authoritative one (REQ-005 requirement #8): it lists only the
    signed-in user's memberships, mutates the circuit's TenantState and persists the choice
    through the REQ-008 query hint, so it survives a reload. The TopHeader's organisation pill
    drives the same real path - it is not a second, decoration-only switcher.
*@
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject CommandPaletteService CommandService
@implements IDisposable

<div class="app-shell">
    <!-- Sidebar -->
    <aside class="app-sidebar @(isSidebarCollapsed ? "collapsed" : "") @(isMobileOpen ? "mobile-open" : "")">
        <NavMenu />
    </aside>

    <!-- Main Content Area -->
    <div class="app-main">
        <!-- Top Header -->
        <TopHeader OnToggleSidebar="ToggleSidebar" />

        <!-- Router Outlet -->
        <main class="page-content-wrapper">
            <div class="shell-tenant-bar">
                <TenantSwitcher />
            </div>

            @Body
        </main>
    </div>
</div>

<!-- Global Modals & Notifications -->
<ToastContainer />
<CommandPalette />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss"><IconSvg Name="close" Size="16" /></span>
</div>

<style>
    .shell-tenant-bar {
        padding: 12px 24px 0;
    }
</style>

@code {
    private bool isSidebarCollapsed = false;
    private bool isMobileOpen = false;
    private DotNetObjectReference<MainLayout>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("orgshield.initKeybindings", dotNetRef);
            }
            catch
            {
                // Fallback if JS not ready
            }
        }
    }

    [JSInvokable]
    public void OpenCommandPalette()
    {
        CommandService.Open();
        StateHasChanged();
    }

    [JSInvokable]
    public void CloseModals()
    {
        CommandService.Close();
        StateHasChanged();
    }

    private void ToggleSidebar()
    {
        isMobileOpen = !isMobileOpen;
        StateHasChanged();
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}
