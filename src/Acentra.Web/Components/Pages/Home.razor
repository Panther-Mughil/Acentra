@code {
    private string selectedTimeFilter = "30D";
    private readonly string[] timeFilters = new[] { "7D", "30D", "90D", "1Y" };

    // The only real figures on this page: product counts for the circuit's tenant, read through the
    // same tenant-scoped service the inventory page uses.
    private int _totalProducts;
    private int _activeProducts;

    protected override void OnInitialized()
    {
        // Tenant.Changed is the authoritative signal (TenantStateService raises its own event from
        // exactly this one), so subscribing once is enough to re-read the rows.
        Tenant.Changed += HandleTenantChanged;
    }

    protected override async Task OnInitializedAsync() => await RefreshMetricsAsync();

    private void HandleTenantChanged() => InvokeAsync(async () =>
    {
        await RefreshMetricsAsync();
        StateHasChanged();
    });

    private async Task RefreshMetricsAsync()
    {
        // No resolved tenant - the `/` route is tenant-agnostic - means no rows and no query: an
        // unresolved tenant is never "all tenants".
        if (!Tenant.IsResolved)
        {
            _totalProducts = 0;
            _activeProducts = 0;
            return;
        }

        try
        {
            var products = await Inventory.ListProductsAsync();

            _totalProducts = products.Count;
            _activeProducts = products.Count(product => product.IsActive);
        }
        catch (Exception)
        {
            _totalProducts = 0;
            _activeProducts = 0;
        }
    }

    private void RefreshInsights()
    {
        ToastService.Success("AI Insights Refreshed", "Operational metrics and supply timelines recalculated.");
    }

    private void TriggerReorderRecommendation()
    {
        ToastService.Info("Drafting Purchase Order", "Pre-filling emergency reorder for 5,000 units of Surgical Nitrile Gloves.");
        Nav.NavigateTo("/orders");
    }

    private void TriggerOptimizationAnalysis()
    {
        ToastService.Success("Consolidation Report", "Supplier logistics optimization analysis loaded.");
        Nav.NavigateTo("/analytics");
    }

    public void Dispose()
    {
        Tenant.Changed -= HandleTenantChanged;
    }
}
