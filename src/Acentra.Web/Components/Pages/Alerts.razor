@page "/alerts"
@inject AlertService AlertService
@inject TenantStateService TenantService
@inject NavigationManager Nav
@inject ToastService ToastService
@implements IDisposable

<div class="page-header-row">
    <div class="page-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            <span class="status-badge @(AlertService.UnreadCount > 0 ? "critical" : "healthy")">
                <IconSvg Name="bell" Size="14" /> @AlertService.UnreadCount Actionable Notifications
            </span>
            <span style="font-size: 12px; color: var(--text-light);">• Scoped to @TenantService.CurrentTenant.Name</span>
        </div>
        <h1>Alert Center</h1>
        <p>Real-time security threats, inventory stockout warnings, and procurement requisition approvals.</p>
    </div>

    <div class="page-actions-group">
        <button class="btn-org btn-org-secondary" @onclick="MarkAllRead" disabled="@(AlertService.UnreadCount == 0)">
            <IconSvg Name="check" Size="14" /> Mark All as Read
        </button>
    </div>
</div>

<!-- Filter Tabs -->
<div class="org-card" style="padding: 10px 16px; margin-bottom: 20px;">
    <div style="display: flex; gap: 8px;">
        @foreach (var tab in new[] { "All", "Critical", "Warning", "Attention", "Resolved" })
        {
            var isSel = selectedTab == tab;
            var count = tab == "All" ? AlertService.GetAlerts().Count : AlertService.GetAlerts().Count(a => a.Severity == tab);
            <button class="btn btn-sm" style="border-radius: var(--border-radius-md); padding: 6px 14px; font-size: 12.5px; font-weight: 600; border: 1px solid @(isSel ? "var(--blue-600)" : "transparent"); background: @(isSel ? "var(--blue-50)" : "transparent"); color: @(isSel ? "var(--blue-700)" : "var(--text-muted)");"
                    @onclick="() => selectedTab = tab">
                @tab (@count)
            </button>
        }
    </div>
</div>

<!-- Alert Cards List -->
<div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px;">
    @if (FilteredAlerts.Count == 0)
    {
        <div class="org-card" style="padding: 40px; text-align: center; color: var(--text-muted);">
            <IconSvg Name="check" Size="36" Class="mb-2" />
            <div style="font-weight: 700; font-size: 15px; color: var(--navy-900);">All clear!</div>
            <div style="font-size: 13px; margin-top: 4px;">No @selectedTab alerts requiring attention.</div>
        </div>
    }
    else
    {
        @foreach (var alert in FilteredAlerts)
        {
            <div class="org-card" style="padding: 18px 22px; border-left: 4px solid @GetSeverityBorderColor(alert.Severity); background-color: @(alert.IsRead ? "#FFFFFF" : "var(--surface-subtle)"); display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;">
                <div style="display: flex; gap: 14px; align-items: flex-start;">
                    <div style="margin-top: 2px;">
                        @switch (alert.Severity)
                        {
                            case "Critical":
                                <span style="color: var(--red-600);"><IconSvg Name="alert-triangle" Size="20" /></span>
                                break;
                            case "Warning":
                                <span style="color: var(--amber-500);"><IconSvg Name="warning" Size="20" /></span>
                                break;
                            case "Attention":
                                <span style="color: var(--blue-600);"><IconSvg Name="bell" Size="20" /></span>
                                break;
                            default:
                                <span style="color: var(--green-600);"><IconSvg Name="check" Size="20" /></span>
                                break;
                        }
                    </div>

                    <div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                            <span class="status-badge @GetSeverityBadgeClass(alert.Severity)" style="font-size: 10px; padding: 2px 6px;">
                                @alert.Severity
                            </span>
                            <span style="font-size: 11px; color: var(--text-light);">• @alert.Timestamp.ToString("MMM dd, HH:mm")</span>
                            <span class="sku-badge" style="font-size: 10.5px;">@alert.Category</span>
                            @if (!alert.IsRead)
                            {
                                <span style="width: 7px; height: 7px; border-radius: 50%; background-color: var(--blue-600);"></span>
                            }
                        </div>

                        <div style="font-weight: 700; font-size: 14.5px; color: var(--navy-900); margin-bottom: 4px;">
                            @alert.Title
                        </div>
                        <p style="font-size: 13px; color: var(--text-main); margin: 0; line-height: 1.4;">
                            @alert.Description
                        </p>
                    </div>
                </div>

                <div style="display: flex; gap: 8px; align-items: center; flex-shrink: 0;">
                    @if (!string.IsNullOrEmpty(alert.ActionText))
                    {
                        <button class="btn-org btn-org-primary btn-org-sm" @onclick="() => HandleAlertAction(alert)">
                            @alert.ActionText
                        </button>
                    }
                    @if (!alert.IsRead)
                    {
                        <button class="btn-org btn-org-secondary btn-org-sm" @onclick="() => AlertService.MarkAsRead(alert.Id)">
                            Mark Read
                        </button>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private string selectedTab = "All";

    private List<AlertItem> FilteredAlerts => AlertService.GetAlerts().Where(a =>
        selectedTab == "All" || a.Severity == selectedTab
    ).ToList();

    protected override void OnInitialized()
    {
        AlertService.OnAlertsChanged += StateHasChanged;
        TenantService.OnTenantChanged += StateHasChanged;
    }

    private void MarkAllRead()
    {
        AlertService.MarkAllAsRead();
        ToastService.Success("Alerts Updated", "All active notifications marked as read.");
    }

    private void HandleAlertAction(AlertItem alert)
    {
        AlertService.MarkAsRead(alert.Id);
        if (!string.IsNullOrEmpty(alert.ActionUrl))
        {
            Nav.NavigateTo(alert.ActionUrl);
        }
    }

    private string GetSeverityBorderColor(string severity) => severity switch
    {
        "Critical" => "var(--red-600)",
        "Warning" => "var(--amber-500)",
        "Attention" => "var(--blue-600)",
        "Resolved" => "var(--green-600)",
        _ => "var(--border-subtle)"
    };

    private string GetSeverityBadgeClass(string severity) => severity switch
    {
        "Critical" => "critical",
        "Warning" => "low-stock",
        "Attention" => "approved",
        "Resolved" => "healthy",
        _ => "draft"
    };

    public void Dispose()
    {
        AlertService.OnAlertsChanged -= StateHasChanged;
        TenantService.OnTenantChanged -= StateHasChanged;
    }
}
